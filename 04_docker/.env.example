COMPOSE_PROJECT_NAME=nginx-flask-mysql-seo-login-lab
HTTP_PORT=8080

MARIADB_IMAGE=mariadb:10.11.18-jammy
MARIADB_DATABASE=example
NGINX_IMAGE=nginx:1.30.4-alpine
BACKEND_IMAGE=nginx-flask-mysql-backend:1.2

SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=480
TRUSTED_HOSTS=localhost,127.0.0.1,backend

APP_ADMIN_USERNAME=admin
APP_ADMIN_ROTATE_PASSWORD=true

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

SEO_MAX_PAGES=25
SEO_REQUEST_TIMEOUT_SECONDS=5
SEO_MAX_RESPONSE_BYTES=2000000
SEO_CRAWL_DELAY_SECONDS=0.15
SEO_MAX_REDIRECTS=5
SEO_USER_AGENT=Nhref-SEO-Auditor/1.2
