# Reject direct-IP and unknown-Host HTTP requests.
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    access_log off;
    return 444;
}

# Keep HTTP available for ACME renewal and for the migration interval before
# ArvanCloud is switched from HTTP Origin to HTTPS Origin.
server {
    listen 80;
    listen [::]:80;

    server_name {{ ([application_domain] + application_aliases) | join(' ') }};

    server_tokens off;
    client_max_body_size {{ nginx_client_max_body_size }};

    add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    error_page 502 503 504 =503 @http_backend_unavailable;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
        add_header Cache-Control "no-store" always;
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location = /health {
        access_log off;
        proxy_pass http://backend:8000/health;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $origin_forwarded_for;
        proxy_set_header X-Forwarded-Proto $origin_forwarded_proto;
        proxy_set_header Authorization "";
    }

    location / {
limit_req zone=seo_audit_per_ip
            burst={{ nginx_audit_burst }}
            nodelay;
        limit_conn seo_connections_per_ip
            {{ nginx_max_connections_per_ip }};

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $origin_forwarded_for;
        proxy_set_header X-Forwarded-Proto $origin_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header X-Country-Code $http_x_country_code;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout {{ nginx_proxy_read_timeout }};
        proxy_read_timeout {{ nginx_proxy_read_timeout }};

        proxy_buffering off;
        proxy_intercept_errors on;
    }

    location @http_backend_unavailable {
        default_type text/plain;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
        return 503 "Service temporarily unavailable\n";
    }
}

# Reject direct-IP and unknown-Host HTTPS requests after the TLS handshake.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    server_name _;

    ssl_certificate {{ letsencrypt_fullchain_path }};
    ssl_certificate_key {{ letsencrypt_private_key_path }};

    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name {{ ([application_domain] + application_aliases) | join(' ') }};

    server_tokens off;
    client_max_body_size {{ nginx_client_max_body_size }};

    ssl_certificate {{ letsencrypt_fullchain_path }};
    ssl_certificate_key {{ letsencrypt_private_key_path }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305';
    ssl_prefer_server_ciphers off;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    error_page 502 503 504 =503 @https_backend_unavailable;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
        add_header Cache-Control "no-store" always;
    }

    # This route exists only in the HTTPS server block. The public verification
    # uses it to prove that ArvanCloud is reaching the Origin over HTTPS.
    location = {{ origin_tls_health_path }} {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header X-Origin-TLS "active" always;
        return 200 "origin-tls-ok\n";
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location = /health {
        access_log off;
        proxy_pass http://backend:8000/health;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $origin_forwarded_for;
        proxy_set_header X-Forwarded-Proto $origin_forwarded_proto;
        proxy_set_header Authorization "";
    }

    location / {
limit_req zone=seo_audit_per_ip
            burst={{ nginx_audit_burst }}
            nodelay;
        limit_conn seo_connections_per_ip
            {{ nginx_max_connections_per_ip }};

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $origin_forwarded_for;
        proxy_set_header X-Forwarded-Proto $origin_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header X-Country-Code $http_x_country_code;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout {{ nginx_proxy_read_timeout }};
        proxy_read_timeout {{ nginx_proxy_read_timeout }};

        proxy_buffering off;
        proxy_intercept_errors on;
    }

    location @https_backend_unavailable {
        default_type text/plain;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
        return 503 "Service temporarily unavailable\n";
    }
}
