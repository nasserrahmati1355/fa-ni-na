# Reject direct-IP and unknown-Host requests.
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    access_log off;
    return 444;
}

server {
    listen 80;
    listen [::]:80;

    server_name {{ ([application_domain] + application_aliases) | join(' ') }};

    server_tokens off;
    client_max_body_size {{ nginx_client_max_body_size }};

    add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
    add_header Pragma "no-cache" always;
    add_header Expires "0" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    error_page 502 503 504 =503 @backend_unavailable;

    location = /nginx-health {
        access_log off;
        auth_basic off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location = /health {
        access_log off;
        auth_basic off;

        proxy_pass http://backend:8000/health;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $origin_forwarded_proto;
        proxy_set_header Authorization "";
    }

    location / {
{% if enable_basic_auth %}
        auth_basic "Nhref SEO Auditor";
        auth_basic_user_file /etc/nginx/auth/htpasswd;
{% endif %}

        limit_req zone=seo_audit_per_ip
            burst={{ nginx_audit_burst }}
            nodelay;
        limit_conn seo_connections_per_ip
            {{ nginx_max_connections_per_ip }};

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $origin_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_set_header X-Country-Code $http_x_country_code;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout {{ nginx_proxy_read_timeout }};
        proxy_read_timeout {{ nginx_proxy_read_timeout }};

        proxy_buffering off;
        proxy_intercept_errors on;
    }

    location @backend_unavailable {
        default_type text/plain;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
        return 503 "Service temporarily unavailable\n";
    }
}
