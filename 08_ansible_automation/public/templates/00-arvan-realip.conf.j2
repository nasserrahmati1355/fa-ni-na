# Generated by Ansible. Trust only current ArvanCloud edge networks.
{% for cidr in arvan_cdn_cidrs %}
set_real_ip_from {{ cidr }};
{% endfor %}

real_ip_header X-Real-IP;
real_ip_recursive on;

map $http_x_forwarded_proto $origin_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_x_forwarded_for $origin_forwarded_for {
    default $http_x_forwarded_for;
    ""      $remote_addr;
}

# Apply the expensive-operation rate limit only to POST requests.
map "$request_method:$uri" $seo_audit_rate_key {
    default "";
    "POST:/audit" $binary_remote_addr;
}

limit_req_zone $seo_audit_rate_key
    zone=seo_audit_per_ip:10m
    rate={{ nginx_audit_rate }};

limit_conn_zone $binary_remote_addr
    zone=seo_connections_per_ip:10m;
