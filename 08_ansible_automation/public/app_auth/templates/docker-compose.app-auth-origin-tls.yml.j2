services:
  db:
    image: "{{ mariadb_image }}"
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: "{{ mariadb_database }}"
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/db-password
    secrets:
      - db-password
    volumes:
      - db-data:/var/lib/mysql
    expose:
      - "3306"
    networks:
      - backnet
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 30s

  backend:
    image: "{{ app_auth_backend_image }}"
    build:
      context: .
      dockerfile: Dockerfile
      target: runtime
    restart: unless-stopped
    init: true
    environment:
      DB_HOST: db
      DB_NAME: "{{ mariadb_database }}"
      DB_USER: root
      DB_PASSWORD_FILE: /run/secrets/db-password
      FLASK_SECRET_KEY_FILE: /run/secrets/flask-secret-key
      SESSION_COOKIE_SECURE: "{{ session_cookie_secure | bool | lower }}"
      SESSION_LIFETIME_MINUTES: "{{ session_lifetime_minutes }}"
      TRUSTED_HOSTS: "{{ trusted_hosts | join(',') }}"
      AUTH_MAX_FAILED_ATTEMPTS: "{{ auth_max_failed_attempts }}"
      AUTH_LOCKOUT_MINUTES: "{{ auth_lockout_minutes }}"
      SEO_MAX_PAGES: "{{ seo_max_pages }}"
      SEO_REQUEST_TIMEOUT_SECONDS: "{{ seo_request_timeout_seconds }}"
      SEO_MAX_RESPONSE_BYTES: "{{ seo_max_response_bytes }}"
      SEO_MAX_REDIRECTS: "{{ seo_max_redirects }}"
      SEO_CRAWL_DELAY_SECONDS: "{{ seo_crawl_delay_seconds }}"
      SEO_USER_AGENT: "Nhref-SEO-Auditor/1.2 (+https://{{ application_domain }}/)"
    secrets:
      - db-password
      - flask-secret-key
    expose:
      - "8000"
    networks:
      - backnet
      - frontnet
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - >-
          import urllib.request;
          urllib.request.urlopen(
          'http://127.0.0.1:8000/health', timeout=3).read()
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 25s

  admin-bootstrap:
    image: "{{ app_auth_backend_image }}"
    profiles:
      - tools
    command:
      - python
      - bootstrap_admin.py
    environment:
      DB_HOST: db
      DB_NAME: "{{ mariadb_database }}"
      DB_USER: root
      DB_PASSWORD_FILE: /run/secrets/db-password
      APP_ADMIN_USERNAME: "{{ app_admin_username }}"
      APP_ADMIN_PASSWORD_FILE: /run/secrets/app-admin-password
      APP_ADMIN_ROTATE_PASSWORD: "{{ app_admin_rotate_password | bool | lower }}"
    secrets:
      - db-password
      - app-admin-password
    networks:
      - backnet
    depends_on:
      db:
        condition: service_healthy
    restart: "no"

  proxy:
    image: "{{ nginx_image }}"
    restart: unless-stopped
    init: true
    ports:
      - "{{ origin_http_port }}:80"
      - "{{ origin_https_port }}:443"
    volumes:
      - ./nginx/00-arvan-realip.conf:/etc/nginx/conf.d/00-arvan-realip.conf:ro
      - ./nginx/10-seo-auditor.conf:/etc/nginx/conf.d/default.conf:ro
      - ./certbot/www:/var/www/certbot:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
    networks:
      - frontnet
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          wget -q -O /dev/null
          --header='Host: {{ application_domain }}'
          http://127.0.0.1/nginx-health || exit 1
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

volumes:
  db-data:
    driver: local

secrets:
  db-password:
    file: ./secrets/db_password.txt
  flask-secret-key:
    file: ./secrets/flask_secret_key.txt
  app-admin-password:
    file: ./secrets/app_admin_password.txt

networks:
  backnet:
    driver: bridge
    internal: true
  frontnet:
    driver: bridge
